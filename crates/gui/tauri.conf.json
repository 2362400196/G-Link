{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PUBG Accel",
  "version": "0.1.0",
  "identifier": "com.pubg.accel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "G-Link",
        "width": 1150,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-window-controls",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
